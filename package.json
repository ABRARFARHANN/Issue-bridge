{
  "name": "issues",
  "version": "1.0.0",
  "description": "MCP Server Issue Tracker - A simple GitHub-style issue tracker",
  "keywords": [
    "issue-tracker",
    "mcp-server",
    "react",
    "fastify"
  ],
  "homepage": "https://github.com/btholt/mcp-issue-tracker#readme",
  "bugs": {
    "url": "https://github.com/btholt/mcp-issue-tracker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btholt/mcp-issue-tracker.git"
  },
  "license": "Apache-2.0",
  "author": "Abrar farhan N",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run preview",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.16.0",
    "sqlite3": "^6.0.1",
    "zod": "^3.25.76"
  }
}
